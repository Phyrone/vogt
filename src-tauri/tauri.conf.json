{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vogt",
  "version": "0.0.1",
  "identifier": "de.phyrone.vogt",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "VOGT",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1REVFNDU3Mjg4NkI1ODAKUldTQXRZWW9WK1RlZGZZNklOL0dGakR3UEt6YzFFYmhVUzdra21zaTZDQk1ONGtQYUdyQk0vemEK",
      "requireSignedVersion": true
    }
  }
}