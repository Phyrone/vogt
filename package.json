{
	"name": "vogt",
	"version": "0.0.1",
	"description": "Version & Operations GUI Tool",
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"build": "tauri build",
		"vite:dev": "vite dev",
		"vite:build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"ios": "tauri ios",
		"android": "tauri android",
		"sv": "sv",
		"skills": "skills",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm test:unit --run && pnpm test:rust && pnpm test:e2e",
		"test:rust": "cd src-tauri && cargo nextest run",
		"test:unit": "vitest",
		"test:unit:ui": "vitest --ui",
		"test:e2e": "playwright install chromium && playwright test",
		"test:e2e:ui": "playwright install chromium && playwright test --ui"
	},
	"license": "MIT",
	"dependencies": {
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-opener": "^2.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"skills": "^1.7.2",
		"sv": "^1.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
