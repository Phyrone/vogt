{
	"name": "vogt",
	"version": "0.0.1",
	"description": "Version & Operations GUI Tool",
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"build": "tauri build",
		"vite:dev": "vite dev",
		"vite:build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"sv": "sv",
		"skills": "skills",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"fmt": "prettier --write .",
		"test": "pnpm test:unit --run && pnpm test:rust && pnpm test:e2e",
		"test:rust": "cargo nextest run",
		"test:unit": "vitest",
		"test:unit:ui": "vitest --ui",
		"test:e2e": "playwright install chromium && playwright test",
		"test:e2e:ui": "playwright install chromium && playwright test --ui",
		"db": "drizzle-kit",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:repo:generate": "drizzle-kit generate --config=drizzle.repo.config.ts",
		"db:repo:prepare": "node scripts/repo-schema.mjs && SQLX_OFFLINE=false DATABASE_URL=sqlite:src-tauri/target/repo-schema.db cargo sqlx prepare --workspace -- --all-targets"
	},
	"license": "MIT",
	"dependencies": {
		"@lucide/svelte": "^1.55.0",
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-sql": "~2.5.0",
		"runed": "^0.37.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/barlow-semi-condensed": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-m-function-matcher": "2.3.4",
		"@inlang/plugin-message-format": "4.5.5",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-virtual": "^3.13.40",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"daisyui": "^5.7.47",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"skills": "^1.7.2",
		"sv": "^1.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
