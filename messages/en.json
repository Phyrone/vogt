	"commit": {
		"amend": "Amend",
		"body_label": "Description",
		"body_placeholder": "Why this change was needed",
		"changed": [
			{
				"declarations": ["input count", "local countPlural = count: plural"],
				"selectors": ["countPlural"],
				"match": {
					"countPlural=one": "{count} file changed",
					"countPlural=other": "{count} files changed"
				}
			}
		],
		"changes": [
			{
				"declarations": ["input count", "local countPlural = count: plural"],
				"selectors": ["countPlural"],
				"match": {
					"countPlural=one": "Changes · {count} file",
					"countPlural=other": "Changes · {count} files"
				}
			}
		],
		"cherry_pick": "Cherry-pick",
		"commit_to": [
			{
				"declarations": ["input count", "input line", "local countPlural = count: plural"],
				"selectors": ["countPlural"],
				"match": {
					"countPlural=one": "Commit {count} file to {line}",
					"countPlural=other": "Commit {count} files to {line}"
				}
			}
		],
		"files_failed": "The changed files could not be read: {reason}",
		"merge_note": "This merge brought the two lines together without changes of its own.",
		"no_files": "This commit changed no files.",
		"not_pushed": "not pushed",
		"rebase_here": "Rebase from here",
		"revert": "Revert",
