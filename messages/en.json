		"stage_all": "Stage all",
		"subject": "Subject",
		"subject_placeholder": "Summary of the change",
		"type": "Type",
		"uncommitted": [
			{
				"declarations": ["input count", "local countPlural = count: plural"],
				"selectors": ["countPlural"],
				"match": {
					"countPlural=one": "Working changes · {count} file, not committed",
					"countPlural=other": "Working changes · {count} files, not committed"
				}
			}
		],
		"unstage_all": "Unstage all",
		"working": "Working changes"
