{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
	"rebaseWhen": "behind-base-branch",
	"semanticCommits": "enabled",
	"semanticCommitType": "⬆️ build",
	"semanticCommitScope": "deps",
	"automerge": true,
	"packageRules": [
		{
			"description": "A rollback is a downgrade, not an upgrade",
			"matchUpdateTypes": ["rollback"],
			"semanticCommitType": "⬇️ build"
		},
		{
			"description": "Neither an upgrade nor a downgrade: the default emoji of the build type",
			"matchUpdateTypes": ["pin", "pinDigest", "replacement", "lockFileMaintenance"],
			"semanticCommitType": "📦️ build"
		},
		{
			"description": "SvelteKit 3 and svelte-check need the compiler API that TypeScript 7 no longer ships; lift this once both support it",
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<7"
		}
	]
}
